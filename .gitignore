# Ignore Unity cache folders globally in all subfolders
**/[L|l]ibrary/
**/[T|t]emp/
**/[O|o]bj/
**/[B|b]uild/
**/[B|b]uilds/
**/[L|l]ogs/
**/[U|u]ser[S|s]ettings/

# Memory dumps
*.kdmp
*.pmp
*.log

# Visual Studio / VS Code cache
**/.vs/
**/.vscode/
**/*.csproj
**/*.sln
**/*.suo
**/*.user
**/*.userprefs
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.opendb
**/*.VC.db

# PlasticSCM temporary files
**/*.plastic/
